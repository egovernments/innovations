# Copy to .env (never commit .env). Generate secrets with: openssl rand -base64 42
#
# Superset: signs sessions and encrypts the database passwords it saves. Keep it stable once set.
SUPERSET_SECRET_KEY=
# Postgres password for Superset's metadata database and the sample "hcm" database.
PG_PASSWORD=
# Superset's "admin" user (made by superset/init.sh). Lenspack also uses it once, on its first start, to create
# its own Superset account; that account's password then stays in Lenspack's volume.
SUPERSET_ADMIN_PASSWORD=
# Optional: the password of a "lenspack" account you manage (Lenspack then uses it as is and makes no account).
# LENSPACK_SUPERSET_PASSWORD=
#
# LLM for the chat. Either an Anthropic key (the chat then offers Claude Sonnet, Opus and Haiku 5.5)...
ANTHROPIC_API_KEY=
# ...or a provider list in Lenspack's format, which wins over ANTHROPIC_API_KEY. Without either, the chat is off.
# LENSPACK_LLM_PROVIDERS=[{"name":"my-model","baseUrl":"https://…/v1","apiKey":"…","model":"my-model"}]
#
# Where Superset listens. 127.0.0.1 = this machine only; set an address to open it to a network.
# BIND_ADDRESS=127.0.0.1
# PORT=8088
# Superset's security headers (CSP). On by default; works because Superset serves Lenspack under its own address.
# TALISMAN_ENABLED=true
# Behind a TLS gateway: trust its X-Forwarded-* headers (then let only the gateway reach PORT).
# ENABLE_PROXY_FIX=true
# Who may change dashboards through the chat: superset (whoever Superset lets edit it; the default) or signed-in.
# LENSPACK_EDIT_POLICY=superset
# Speech to text for the chat's microphone (OpenRouter). Empty: no microphone.
# OPENROUTER_API_KEY=
# The sample data, as Superset connects to it. Defaults to the "hcm" Postgres database in this stack.
# DATA_SQLALCHEMY_URI=
#
# HCM analytics on ClickHouse (optional; README "Data"). The tunnel service port-forwards to ClickHouse in a
# Kubernetes cluster with a read kubeconfig.
# CLICKHOUSE_KUBECONFIG=/home/me/.kube/cluster-read
# CLICKHOUSE_KUBE_CONTEXT=cluster-read
# CLICKHOUSE_KUBE_NAMESPACE=clickhouse
# CLICKHOUSE_KUBE_SERVICE=svc/clickhouse
# Or reach ClickHouse directly instead of the tunnel:
# CLICKHOUSE_HOST=clickhouse-tunnel
# CLICKHOUSE_PORT=8123
# CLICKHOUSE_DATABASE=analytics
# Tenant for the targets and referrals marts (the su_ni_* views are eGov's views for the ng field test).
# CLICKHOUSE_TENANT=ng
# Read-only ClickHouse user. Pass the password to setup with -e rather than writing it here; Superset keeps it
# (encrypted with SUPERSET_SECRET_KEY) in its database settings.
# CLICKHOUSE_USER=
# CLICKHOUSE_PASSWORD=
# Lenspack config in lenspack/: lenspack-superset.yaml (sample) or lenspack-superset.clickhouse.yaml.
# LENSPACK_CONFIG=lenspack-superset.yaml
# Lenspack version: its published image, tagged with a commit of github.com/theflywheel/lenspack (main).
# Superset's image copies lenspack_superset.py from it: run `docker compose up -d --build` after changing it.
# LENSPACK_IMAGE=ghcr.io/theflywheel/lenspack:d9d4def

# Mapbox public token (pk.…) for the basemap under Superset's deck.gl map charts.
# Empty: map charts draw their points on a blank background. Superset 6 can use
# OpenStreetMap tiles instead (DECKGL_BASE_MAP); 5.0 needs Mapbox.
MAPBOX_API_KEY=
