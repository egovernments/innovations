# Copy to .env (never commit .env). Generate secrets with: openssl rand -base64 42
#
# Superset: signs sessions and encrypts the database passwords it saves. Keep it stable once set.
SUPERSET_SECRET_KEY=
# Postgres password for Superset's metadata database and the sample "hcm" database.
PG_PASSWORD=
# Superset's "admin" user (made by superset/init.sh).
SUPERSET_ADMIN_PASSWORD=
# Superset's "lenspack" service account, which Lenspack signs in as.
LENSPACK_SUPERSET_PASSWORD=
#
# LLM for the chat. Either an Anthropic key (Claude Sonnet, Opus and Haiku 5.5)...
ANTHROPIC_API_KEY=
# ...or a provider list in Lenspack's format, which wins over ANTHROPIC_API_KEY. Without either, the chat is off.
# LENSPACK_LLM_PROVIDERS=[{"name":"my-model","baseUrl":"https://…/v1","apiKey":"…","model":"my-model"}]
#
# Where the proxy listens. 127.0.0.1 = this machine only; set an address to open it to a network.
# BIND_ADDRESS=127.0.0.1
# PORT=8088
# Superset's security headers (CSP). On by default; works because Lenspack is served under Superset's address.
# TALISMAN_ENABLED=true
# The "beside" page on its own port (BESIDE_PORT) frames Superset: list the origins browsers use for it,
# space-separated. They go into the CSP's frame-ancestors. Unset = Superset can't be framed from another port.
# LENSPACK_BESIDE_ORIGINS="http://my-host:8795"
# Link to the beside page on Settings → Manage → AI assistant (optional).
# LENSPACK_BESIDE_URL=http://my-host:8795
# The sample data, as Superset connects to it. Defaults to the "hcm" Postgres database in this stack.
# DATA_SQLALCHEMY_URI=
#
# HCM analytics on ClickHouse (optional; README "Data"). The tunnel service port-forwards to ClickHouse in a
# Kubernetes cluster with a read kubeconfig.
# CLICKHOUSE_KUBECONFIG=/home/me/.kube/cluster-read
# CLICKHOUSE_KUBE_CONTEXT=cluster-read
# CLICKHOUSE_KUBE_NAMESPACE=clickhouse
# CLICKHOUSE_KUBE_SERVICE=svc/clickhouse
# Or reach ClickHouse directly instead of the tunnel:
# CLICKHOUSE_HOST=clickhouse-tunnel
# CLICKHOUSE_PORT=8123
# CLICKHOUSE_DATABASE=analytics
# Tenant the datasets are limited to.
# CLICKHOUSE_TENANT=ng
# Read-only ClickHouse user. Pass the password to setup with -e rather than writing it here; Superset keeps it
# (encrypted with SUPERSET_SECRET_KEY) in its database settings.
# CLICKHOUSE_USER=
# CLICKHOUSE_PASSWORD=
# Lenspack config: lenspack-superset.yaml (sample) or lenspack-superset.clickhouse.yaml.
# LENSPACK_CONFIG=lenspack-superset.yaml

# Mapbox public token (pk.…) for the basemap under Superset's deck.gl map charts.
# Empty: map charts draw their points on a blank background. Superset 6 can use
# OpenStreetMap tiles instead (DECKGL_BASE_MAP); 5.0 needs Mapbox.
MAPBOX_API_KEY=
